# ── Deploy-time generated / sensitive ────────────────────────────────
src/config/database.php          # DB credentials (written by the installer)
src/config/signing_key.php        # HMAC signing key (auto-generated on first use)
src/public/uploads/              # uploaded images (legacy root; branding logo remains)
src/storage/uploads/             # uploaded images (v1.5.0-beta.1 media root, outside web root)
src/storage/incoming/            # pending uploads (staging)
src/var/                        # rate-limit counters
backups/                        # backup archives
src/debug_session.php           # server-diagnostics tool (dev only)

# ── Third-party SDKs (shipped inside release ZIPs, not the repo) ──────
# Object-storage SDKs are bundled at release time via tools/_package.py;
# committing 67MB of vendor code bloats the repo for no reason.
src/sdk/

# ── Build artifacts / packaging ───────────────────────────────────────
releases/
*.zip

# ── DSH agent memory (deployment & credential discussion) ─────────────
.dsh/
# 本地代理工作数据（日志/记忆/验证 harness）—— 同 .dsh/，不得进公开仓库；
# release.py 用 `git add -A`，若不忽略会把本地记忆一起提交
.workbuddy/


# ── OS / editor cruft ─────────────────────────────────────────────────
nul
Thumbs.db
.DS_Store
*.log
tools/__pycache__/
reference/

# ── Local-only tooling (release scripts never ship to the repo) ──────
/tools/

# ── Brand design assets (local source art only) ──────────────────────
/assets/
