# Apache 2.4
<IfModule mod_authz_core.c>
    <FilesMatch "\.(php|php\.|phtml|pht|phar|shtml|inc)$">
        Require all denied
    </FilesMatch>
</IfModule>

# Apache 2.2
<IfModule !mod_authz_core.c>
    <FilesMatch "\.(php|php\.|phtml|pht|phar|shtml|inc)$">
        Order deny,allow
        Deny from all
    </FilesMatch>
</IfModule>
