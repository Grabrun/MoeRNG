# =============================================================================
# APACHE ONLY.
#
# Nginx completely ignores this file. If your server runs Nginx (including
# Baota / 宝塔 panel installs under /www/wwwroot/), none of these rules apply
# and every route except "/" will return 404. Use nginx.conf.example instead.
# =============================================================================

RewriteEngine On

# -----------------------------------------------------------------------------
# Deny rules MUST come before the catch-all rewrite below, otherwise the
# catch-all matches first and these are never evaluated.
#
# 清单必须与 src/nginx.conf.example:49 保持一致。storage/ 是本地媒体根
# （LocalDriver DEFAULT_REL_DIR = 'storage/uploads'），漏掉它会让 Apache 部署
# 下整个图库可被匿名直接下载，/files 的 HMAC 签名形同虚设。
# -----------------------------------------------------------------------------
RewriteRule ^(config|app|views|releases|backups|var|storage)/ - [F,L]
RewriteRule ^\. - [F,L]

<FilesMatch "\.(env|sql|zip|md|log|ini|lock|ya?ml)$">
    Require all denied
</FilesMatch>

# ⚠️ 不要在 .htaccess 根写 <FilesMatch "\.php$"> Require all denied。
#
# <FilesMatch> 对当前目录**及所有子目录**递归生效，而本文件所在的 src/ 正是
# 前端控制器目录 —— 写了会让 index.php / api.php / admin.php / install.php /
# doctor.php / bootstrap.php 全部 403，Apache 部署直接全站瘫痪。
# （MR-14 曾这样改过一轮，线上用 Nginx 未暴露。现有 CI 也不检查本文件。）
# 禁止上传目录执行 PHP 靠它们自带的 .htaccess（public/uploads/、storage/incoming/）；
# 需要 vhost 级兜底请在 Apache 站点配置里加，**不要**写在这里。

# -----------------------------------------------------------------------------
# Front controllers
# -----------------------------------------------------------------------------

# Existing files and directories are served as-is
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

RewriteRule ^api(/.*)?$     api.php     [QSA,L]
RewriteRule ^admin(/.*)?$   admin.php   [QSA,L]
RewriteRule ^install(/.*)?$ install.php [QSA,L]

RewriteRule ^(.*)$ index.php [QSA,L]

# -----------------------------------------------------------------------------
# PHP settings (mod_php only; on PHP-FPM set these in php.ini / pool config)
# -----------------------------------------------------------------------------
<IfModule mod_php.c>
    php_value upload_max_filesize 50M
    php_value post_max_size 55M
    php_value max_execution_time 120
</IfModule>

# -----------------------------------------------------------------------------
# v2.0.0-beta.9 前端性能优化: 静态资源长缓存。
# 所有 URL 均带 ASSET_VER 指纹（APP_VERSION.mtime），内容不可变，可安全 immutable；
# 图片缩略图/原图为生成后不可变文件。Apache 部署补齐，nginx 见 nginx.conf.example。
# 依赖 mod_headers；模块缺失时静默跳过，不影响站点。
# -----------------------------------------------------------------------------
<IfModule mod_headers.c>
    <FilesMatch "\.(css|js|mjs|webp|png|jpg|jpeg|gif|svg|ico|woff2?|ttf|eot)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
</IfModule>
